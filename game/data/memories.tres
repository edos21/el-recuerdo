id = "health"
kind = 1
icon = ExtResource("4_mkrju")
fades_at = 0.5
pickup_char = "3"
pickup_icon_scale = 2.0
pickup_message = "Un relicario pequeño, todavía tibio, como si alguien lo hubiera sostenido hace un instante. Recuerdo lo que se siente estar vivo de verdad, con todo lo que eso implica. [Recuerdo de Vida recuperado]"

[sub_resource type="Resource" id="Resource_qk6l0"]
script = ExtResource("1_01mlc")
id = "attack"
kind = 1
icon = ExtResource("5_av7be")
fades_at = 0.75
pickup_char = "4"
pickup_icon_scale = 2.0
pickup_message = "Una espada corta, con el filo gastado de uso real, no de exhibición. Recuerdo la firmeza de sostenerla, la decisión de no quedarme quieto. Presioná X para atacar. [Recuerdo del Guerrero recuperado]"

