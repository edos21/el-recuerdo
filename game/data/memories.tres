[sub_resource type="Resource" id="Resource_8sk44"]
script = ExtResource("1_01mlc")
id = "jump"
kind = 1
icon = ExtResource("2_ojr4l")
pickup_char = "1"
pickup_icon_scale = 2.0
pickup_message = "Una cuerda de saltar, gastada por el uso. Recuerdo el sonido que hacía al golpear el suelo, una y otra vez, sin pensar. Así se sentía moverse sin dudar. Presioná Espacio para saltar. [Recuerdo del Saltador recuperado]"

[sub_resource type="Resource" id="Resource_tslmd"]
script = ExtResource("1_01mlc")
id = "sprint"
kind = 1
icon = ExtResource("3_ac5jn")
fades_at = 0.25
pickup_char = "2"
pickup_icon_scale = 2.0
pickup_message = "Unos zapatos viejos, todavía atados. Me gustaba salir a correr con ellos — me sentía ágil, liviano, rápido. Como un corredor. Mantené Shift apretado mientras te movés para correr. [Recuerdo del Corredor recuperado]"

[sub_resource type="Resource" id="Resource_dtna5"]
